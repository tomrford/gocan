BO_ 1 Mode: 2 Gateway
 SG_ Selector M : 0|4@1+ (1,0) [0|15] "" Inverter,Charger
 SG_ Speed m0 : 8|8@1+ (0.5,-20) [-20|107.5] "rpm" Inverter
 SG_ Torque m1 : 8|8@1- (0.25,0) [-32|31.75] "Nm" Inverter
 SG_ Nested m2M : 4|4@1+ (1,0) [0|15] "" Charger
 SG_ Deep m2 : 8|8@1+ (1,0) [0|255] "" Charger

BO_ 2550136832 Wide: 64 Inverter
 SG_ Tiny : 0|16@1+ (1e-05,0) [0|0.65535] "V" Tester
 SG_ Huge : 16|32@1+ (1000000,-1e+15) [-1e+15|4.294967295e+15] "W" Tester
 SG_ Single : 48|32@1- (1,0) [-3.4e+38|3.4e+38] "" Tester
 SG_ Double : 80|64@1- (1,0) [0|0] "" Tester
 SG_ BigEndian : 151|12@0- (-0.125,0.0625) [-256|256] "°C"

BO_ 2566844160 Diagnostic: 8 Tester
 SG_ Code : 7|16@0+ (1,0) [0|65535] "" Gateway

BO_ 1792 Nameless: 0 Vector__XXX

BO_TX_BU_ 1 : Gateway,Charger,Tester;
BO_TX_BU_ 2550136832 : Inverter;

CM_ "Round-trip fixture with \"quotes\", C:\path\ and \\server";
CM_ BU_ Gateway "Routes
between buses";
CM_ BU_ Tester "Prüfstand";
CM_ BO_ 1 "Multiplexed mode";
